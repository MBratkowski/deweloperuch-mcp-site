{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Factory QA agent output",
  "type": "object",
  "additionalProperties": false,
  "required": ["drafts", "suggestions", "dropped"],
  "properties": {
    "drafts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title", "severity", "fingerprints", "problem", "actual", "expected",
          "why", "acceptance", "sources", "reproduction"
        ],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "severity": {"enum": ["S1", "S2", "S3", "S4"]},
          "fingerprints": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^[0-9a-f]{12}$"}
          },
          "problem": {"type": "string", "minLength": 1},
          "actual": {"type": "string", "minLength": 1},
          "expected": {"type": "string", "minLength": 1},
          "why": {"type": "string", "minLength": 1},
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "sources": {"type": "array", "items": {"type": "string"}},
          "reproduction": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "groups", "script"],
            "properties": {
              "kind": {"enum": ["detector", "script"]},
              "groups": {"type": "array", "items": {"type": "object"}},
              "script": {
                "type": ["string", "null"],
                "pattern": "^factory-out/repros/[A-Za-z0-9_.-]+\\.py$"
              }
            }
          }
        }
      }
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "problem", "screenshot"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "problem": {"type": "string", "minLength": 1},
          "screenshot": {"type": "string", "minLength": 1}
        }
      }
    },
    "dropped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprint", "reason"],
        "properties": {
          "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{12}$"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
