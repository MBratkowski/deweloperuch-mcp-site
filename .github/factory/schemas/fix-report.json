{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Factory fixer report",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "reason", "test_ids", "cause", "change", "baselines"],
  "properties": {
    "status": {"enum": ["fixed", "not_reproducible", "needs_human"]},
    "reason": {"type": "string", "maxLength": 5000},
    "test_ids": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string", "pattern": "^tests/.+[.]py::.+$"}
    },
    "cause": {"type": "string", "maxLength": 5000},
    "change": {"type": "string", "maxLength": 5000},
    "baselines": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "reason"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
